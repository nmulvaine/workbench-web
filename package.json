{
  "name": "workbench-cloud",
  "private": true,
  "version": "0.1.0",
  "description": "Cloudflare web application and canonical cloud-sync service for Workbench across web, Android, iOS, and macOS.",
  "engine": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/sync-contracts",
    "packages/domain",
    "packages/storage",
    "workers/api",
    "apps/web"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
