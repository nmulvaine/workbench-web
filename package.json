{
  "name": "workbench-web",
  "private": true,
  "version": "0.1.0",
  "description": "Astro web client and Cloudflare sync foundation for Workbench.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/sync-contracts",
    "workers/api"
  ],
  "scripts": {
    "astro": "astro",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && astro preview",
    "deploy": "wrangler deploy",
    "api:dev": "wrangler dev --config infra/wrangler.toml --env local",
    "api:dry-run:staging": "wrangler deploy --config infra/wrangler.toml --env staging --dry-run",
    "api:dry-run:production": "wrangler deploy --config infra/wrangler.toml --env production --dry-run",
    "cf-typegen": "wrangler types",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "astro sync && npm run typecheck --workspaces --if-present && tsc --noEmit",
    "check": "npm test && npm run typecheck && npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "astro": "7.3.8",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "vitest": "5.0.4",
    "wrangler": "4.151.0"
  }
}
