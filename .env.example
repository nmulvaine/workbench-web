# Public client configuration
PUBLIC_APP_ORIGIN=http://localhost:8788
PUBLIC_API_ORIGIN=http://localhost:8787

# Local development placeholders only; production values belong in Wrangler secrets.
OAUTH_APPLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_ID=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Workbench

# Binding names are configured in wrangler.toml, not stored as secrets.
D1_DATABASE_NAME=workbench-dev
R2_BUCKET_NAME=workbench-assets-dev
