---
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<div class="workspace-shell">
			<aside class="sidebar" aria-label="Workspace navigation">
				<a class="brand" href="/" aria-label="Workbench home"><span class="brand-mark">W</span><span>Workbench</span></a>
				<div class="workspace-picker"><span class="workspace-avatar">P</span><span><strong>Personal workspace</strong><small>Local workspace</small></span><span class="chevron" aria-hidden="true">⌄</span></div>
				<p class="nav-label">WORKSPACE</p>
				<nav class="primary-nav" aria-label="Main">
					<a class="nav-item active" href="#overview" data-view="overview"><span aria-hidden="true">⌂</span>Overview</a>
					<a class="nav-item" href="#projects" data-view="projects"><span aria-hidden="true">▦</span>Projects</a>
					<a class="nav-item" href="#thoughts" data-view="thoughts"><span aria-hidden="true">✳</span>Thoughts</a>
					<a class="nav-item" href="#tasks" data-view="tasks"><span aria-hidden="true">☷</span>Tasks</a>
					<a class="nav-item" href="#notes" data-view="notes"><span aria-hidden="true">▤</span>Notes</a>
					<a class="nav-item" href="#canvas" data-view="canvas"><span aria-hidden="true">▧</span>Canvas</a>
					<a class="nav-item" href="#wiki" data-view="wiki"><span aria-hidden="true">⌘</span>Wiki</a>
				</nav>
				<div class="sidebar-bottom">
					<a class="nav-item" href="#settings" data-view="settings"><span aria-hidden="true">⚙</span>Settings</a>
					<div class="profile"><span class="profile-avatar">N</span><span><strong>Personal account</strong><small>Sync not connected</small></span><span class="more" aria-hidden="true">···</span></div>
				</div>
			</aside>

			<main class="main-area">
				<header class="topbar">
					<button class="mobile-menu" type="button" aria-label="Toggle workspace navigation" aria-expanded="false">☰</button>
					<div class="breadcrumbs"><span>Personal workspace</span><span aria-hidden="true">/</span><strong id="crumb-current">Overview</strong></div>
					<div class="topbar-actions"><span class="offline-pill"><span></span>Local only</span><button class="icon-button" type="button" aria-label="Help">?</button><span class="top-avatar" aria-label="Personal account">N</span></div>
				</header>

				<div class="content-wrap">
					<section class="view-panel" id="view-overview" data-panel="overview">
						<div class="welcome-row"><div><p class="eyebrow" id="today-label">YOUR WORKSPACE</p><h1 id="greeting">Welcome back</h1><p class="subheading">Your ideas, projects, and plans have a place to grow.</p></div><span class="welcome-mark" aria-hidden="true">✦</span></div>
						<div class="status-banner"><span class="status-icon" aria-hidden="true">☁</span><div><strong>Cloud sync is not connected yet</strong><p>This workspace stays local until secure sign-in and sync are ready. Your current files are not being uploaded.</p></div><span class="status-tag">SETUP IN PROGRESS</span></div>
						<div class="section-heading"><div><h2>Your workspace</h2><p>Choose a space to start organizing your work.</p></div></div>
						<div class="feature-grid">
							<a class="feature-card lavender" href="#projects" data-view="projects"><span class="feature-icon">▦</span><span class="feature-title">Projects</span><span class="feature-copy">Organize work into focused spaces.</span><span class="feature-arrow">↗</span></a>
							<a class="feature-card peach" href="#thoughts" data-view="thoughts"><span class="feature-icon">✳</span><span class="feature-title">Thoughts</span><span class="feature-copy">Capture ideas before they disappear.</span><span class="feature-arrow">↗</span></a>
							<a class="feature-card mint" href="#tasks" data-view="tasks"><span class="feature-icon">☷</span><span class="feature-title">Tasks</span><span class="feature-copy">Keep the next steps in sight.</span><span class="feature-arrow">↗</span></a>
							<a class="feature-card blue" href="#notes" data-view="notes"><span class="feature-icon">▤</span><span class="feature-title">Notes</span><span class="feature-copy">Give your working notes a home.</span><span class="feature-arrow">↗</span></a>
							<a class="feature-card yellow" href="#canvas" data-view="canvas"><span class="feature-icon">▧</span><span class="feature-title">Canvas</span><span class="feature-copy">Explore visual thinking and sketches.</span><span class="feature-arrow">↗</span></a>
							<a class="feature-card rose" href="#wiki" data-view="wiki"><span class="feature-icon">⌘</span><span class="feature-title">Wiki</span><span class="feature-copy">Build a connected knowledge library.</span><span class="feature-arrow">↗</span></a>
						</div>
						<div class="lower-grid"><section class="panel"><div class="panel-heading"><div><h2>Recent activity</h2><p>Updates from across your workspace.</p></div><span class="quiet-badge">LOCAL</span></div><div class="empty-state"><span class="empty-icon">✧</span><strong>Your activity will appear here</strong><p>Create something in your workspace to get started.</p></div></section><section class="panel sync-panel"><div class="panel-heading"><div><h2>Sync status</h2><p>Connect your devices when sync is available.</p></div><span class="sync-dot"></span></div><div class="device-row"><span class="device-icon">⌘</span><span><strong>This browser</strong><small>Local workspace</small></span><span class="device-state">THIS DEVICE</span></div><div class="sync-footnote">Automatic sync is disabled while the service is under development.</div></section></div>
					</section>

					<section class="view-panel feature-view" id="view-feature" data-panel="feature" hidden>
						<p class="eyebrow" id="feature-eyebrow">WORKSPACE</p><div class="feature-view-heading"><div><h1 id="feature-heading">Projects</h1><p class="subheading" id="feature-description"></p></div><button class="create-action" id="create-button" type="button" hidden>＋ Create</button></div>
						<div class="status-banner compact"><span class="status-icon">⌂</span><div><strong>Saved on this browser</strong><p>Project and thought edits are stored locally with a durable sync outbox. They are not uploaded while sync is disabled.</p></div><span class="status-tag">LOCAL ONLY</span></div>
						<form id="local-create-form" class="panel local-form" hidden>
							<label for="local-title">Title</label><input id="local-title" name="title" maxlength="160" required autocomplete="off" />
							<label for="local-body">Description</label><textarea id="local-body" name="body" rows="4" maxlength="10000"></textarea>
							<div class="form-actions"><span id="save-status" role="status" aria-live="polite"></span><button type="submit">Save on this browser</button></div>
						</form>
						<section id="cloud-sync-settings" class="panel local-form" hidden aria-labelledby="cloud-sync-title">
							<h2 id="cloud-sync-title">Cloudflare project sync</h2>
							<p>Sign in with Cloudflare Access. Your short-lived ID token stays in this browser tab and is cleared when you disconnect.</p>
							<label for="sync-endpoint">Sync API URL</label><input id="sync-endpoint" type="url" autocomplete="url" />
							<div class="form-actions"><span id="cloud-sync-status" role="status" aria-live="polite">Not connected</span><span><button id="cloud-connect" type="button">Sign in with Cloudflare Access</button> <button id="cloud-sync-now" type="button" disabled>Sync Now</button> <button id="cloud-disconnect" type="button" class="secondary-action" hidden>Disconnect</button></span></div>
						</section>
						<div id="local-record-list" class="local-record-list" aria-live="polite"></div>
						<div class="panel feature-empty" id="feature-empty"><span class="empty-icon">✧</span><strong id="feature-empty-title">Nothing here yet</strong><p>Start on this browser. Other feature areas will connect in later slices.</p></div>
					</section>
				</div>
				<footer class="app-footer"><span>Workbench</span><span>Local-first workspace</span></footer>
			</main>
		</div>
		<script>
							import { decodePayload, getInstallationDeviceID, listLocalRecords, listOutbox, moveLocalScope, saveLocalRecord } from '../../packages/storage/src/indexeddb';
							import { syncWorkspace } from '../../packages/storage/src/api-client';
			import { WORKBENCH_WORKSPACE_ID } from '../../packages/sync-contracts/src/envelope';
			const labels = { overview: ['Overview', '', ''], projects: ['Projects', 'Organize work into focused spaces.', 'No projects yet'], thoughts: ['Thoughts', 'Capture ideas and turn them into meaningful work.', 'No thoughts yet'], tasks: ['Tasks', 'Keep the next steps in sight.', 'No tasks yet'], notes: ['Notes', 'Keep working notes alongside your projects.', 'No notes yet'], canvas: ['Canvas', 'Think visually with boards, drawings, and media.', 'No canvases yet'], wiki: ['Wiki', 'Build a connected library of knowledge.', 'No pages yet'], settings: ['Settings', 'Manage your workspace preferences and connected devices.', 'Settings are not available yet'] };
			const links = [...document.querySelectorAll('[data-view]')];
			const overview = document.querySelector('[data-panel="overview"]');
			const feature = document.querySelector('[data-panel="feature"]');
			const createButton = document.querySelector('#create-button');
			const createForm = document.querySelector('#local-create-form');
			const recordList = document.querySelector('#local-record-list');
			const featureEmpty = document.querySelector('#feature-empty');
			const cloudSettings = document.querySelector('#cloud-sync-settings');
			const cloudStatus = document.querySelector('#cloud-sync-status');
			const cloudEndpoint = document.querySelector('#sync-endpoint');
			const cloudSyncButton = document.querySelector('#cloud-sync-now');
			const cloudDisconnectButton = document.querySelector('#cloud-disconnect');
			const scope: { accountID: string; workspaceID: string; deviceID?: string } = { accountID: 'local-browser', workspaceID: WORKBENCH_WORKSPACE_ID };
			const recordKinds = { projects: 'project', thoughts: 'idea' };
			let activeView = 'overview';
			let syncInFlight = false;
			let scheduledSync;
			let lastSyncAt = 0;
			async function renderLocalRecords(view) {
				activeView = view;
				const kind = recordKinds[view];
				if (!kind) { recordList.replaceChildren(); featureEmpty.hidden = false; cloudSettings.hidden = view !== 'settings'; return; }
				cloudSettings.hidden = true;
				try {
					const [records, outbox] = await Promise.all([listLocalRecords(scope, kind), listOutbox(scope)]);
					recordList.replaceChildren();
					for (const record of records.filter((item) => !item.isTombstone)) {
						const payload = decodePayload(record.payload);
						const article = document.createElement('article'); article.className = 'local-record panel';
						const title = document.createElement('h2'); title.textContent = payload.strings.title ?? 'Untitled';
						const body = document.createElement('p'); body.textContent = payload.strings.notes ?? payload.strings.content ?? '';
						const status = document.createElement('small'); status.textContent = outbox.some((entry) => entry.mutationID === `${record.entityKind}:${record.id}:${record.revision.counter}:${record.revision.originDeviceID}`) ? 'Saved here · waiting for sync' : 'Saved on this browser';
						article.append(title, body, status);
						const actions = document.createElement('div'); actions.className = 'form-actions';
						const edit = document.createElement('button'); edit.type = 'button'; edit.textContent = 'Edit';
						edit.addEventListener('click', async () => {
							const bodyKey = kind === 'project' ? 'notes' : 'content';
							const nextTitle = window.prompt('Project title', payload.strings.title ?? '');
							if (nextTitle === null) return;
							const nextBody = window.prompt(kind === 'project' ? 'Project notes' : 'Thought', payload.strings[bodyKey] ?? '');
							if (nextBody === null || !nextTitle.trim()) return;
							const next = { ...payload, strings: { ...payload.strings, title: nextTitle.trim(), [bodyKey]: nextBody.trim() }, dates: { ...payload.dates, updatedAt: new Date().toISOString().replace(/\.\d{3}Z$/, 'Z') } };
							await saveLocalRecord(scope, kind, next, record.id);
							scheduleForegroundSync('local edit');
							await renderLocalRecords(view);
						});
						const remove = document.createElement('button'); remove.type = 'button'; remove.className = 'secondary-action'; remove.textContent = 'Delete';
						remove.addEventListener('click', async () => {
							if (!window.confirm(`Delete “${payload.strings.title ?? 'Untitled'}”? This will sync as a deletion.`)) return;
							await saveLocalRecord(scope, kind, payload, record.id, true);
							scheduleForegroundSync('local deletion');
							await renderLocalRecords(view);
						});
						actions.append(edit, remove); article.append(actions); recordList.append(article);
					}
					featureEmpty.hidden = records.some((record) => !record.isTombstone);
				} catch (error) {
					recordList.replaceChildren(); featureEmpty.hidden = false;
					document.querySelector('#feature-empty-title').textContent = 'Local storage is unavailable';
					document.querySelector('#save-status').textContent = String(error);
				}
			}
			function showView(view) {
				const [label, description, emptyTitle] = labels[view] ?? labels.overview;
				const isOverview = view === 'overview';
				overview.hidden = !isOverview;
				feature.hidden = isOverview;
				document.querySelector('#crumb-current').textContent = label;
				document.querySelector('#feature-heading').textContent = label;
				document.querySelector('#feature-description').textContent = description;
				document.querySelector('#feature-empty-title').textContent = emptyTitle;
				const canCreate = Boolean(recordKinds[view]);
				createButton.hidden = !canCreate;
				cloudSettings.hidden = view !== 'settings';
				createButton.textContent = view === 'projects' ? '＋ New project' : '＋ New thought';
				createForm.hidden = true;
				links.forEach((link) => link.classList.toggle('active', link.dataset.view === view));
				history.replaceState(null, '', isOverview ? '/' : `#${view}`);
				if (!isOverview) void renderLocalRecords(view);
			}
			links.forEach((link) => link.addEventListener('click', (event) => { event.preventDefault(); showView(link.dataset.view); }));
			createButton.addEventListener('click', () => { createForm.hidden = !createForm.hidden; if (!createForm.hidden) document.querySelector('#local-title').focus(); });
			createForm.addEventListener('submit', async (event) => {
				event.preventDefault();
				const title = new FormData(createForm).get('title').toString().trim();
				const body = new FormData(createForm).get('body').toString().trim();
				if (!title) return;
				const now = new Date().toISOString().replace(/\.\d{3}Z$/, 'Z');
				const payload = activeView === 'projects'
					? { strings: { title, notes: body }, dates: { createdAt: now, updatedAt: now } }
					: { strings: { title, content: body, category: 'General' }, dates: { createdAt: now, updatedAt: now } };
				try {
					await saveLocalRecord(scope, recordKinds[activeView], payload);
					scheduleForegroundSync('local edit');
					createForm.reset(); document.querySelector('#save-status').textContent = 'Saved locally.';
					await renderLocalRecords(activeView);
				} catch (error) { document.querySelector('#save-status').textContent = `Could not save: ${String(error)}`; }
			});
			const storedToken = sessionStorage.getItem('workbench-sync-token') ?? '';
			const defaultSyncEndpoint = 'https://workbench-sync-api-staging.nmulvaine.workers.dev';
			const storedEndpoint = sessionStorage.getItem('workbench-sync-endpoint') ?? defaultSyncEndpoint;
			cloudEndpoint.value = storedEndpoint;
			if (storedToken) {
				try {
					const claims = JSON.parse(atob(storedToken.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));
					if (claims.sub && (!claims.exp || claims.exp * 1000 > Date.now())) {
						scope.accountID = claims.sub;
						scope.deviceID = await getInstallationDeviceID();
						await moveLocalScope({ accountID: 'local-browser', workspaceID: WORKBENCH_WORKSPACE_ID }, { accountID: claims.sub, workspaceID: WORKBENCH_WORKSPACE_ID });
					} else sessionStorage.removeItem('workbench-sync-token');
				} catch { sessionStorage.removeItem('workbench-sync-token'); }
			}
			function updateCloudControls(connected) {
				cloudSyncButton.disabled = !connected;
				cloudDisconnectButton.hidden = !connected;
				cloudStatus.textContent = connected ? 'Connected · manual Sync Now' : 'Not connected';
			}
			updateCloudControls(Boolean(sessionStorage.getItem('workbench-sync-token')));
			function requireSignIn() {
				sessionStorage.removeItem('workbench-sync-token');
				updateCloudControls(false);
			}
			function encodeBase64Url(bytes) { return btoa(String.fromCharCode(...bytes)).replace(/=/g, '').replace(/\+/g, '-').replace(/\//g, '_'); }
			async function connectAccessToken(token, endpoint) {
				try {
					const claims = JSON.parse(atob(token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));
					if (!claims.sub) throw new Error('Token has no account subject');
					const deviceID = await getInstallationDeviceID();
					const keyKey = 'workbench-sync-public-key:' + deviceID;
					let publicKey = localStorage.getItem(keyKey);
					if (!publicKey) { publicKey = await crypto.subtle.generateKey({ name: 'ECDSA', namedCurve: 'P-256' }, true, ['sign', 'verify']).then((key) => crypto.subtle.exportKey('spki', key.publicKey)).then((buffer) => btoa(String.fromCharCode(...new Uint8Array(buffer)))); localStorage.setItem(keyKey, publicKey); }
					const response = await fetch(new URL('/sync/enroll', endpoint), { method: 'POST', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ workspaceID: WORKBENCH_WORKSPACE_ID }) });
					if (!response.ok) throw new Error(`Workspace enrollment failed with HTTP ${response.status}`);
					const enrolled = await fetch(new URL(`/sync/workspaces/${encodeURIComponent(WORKBENCH_WORKSPACE_ID)}/devices`, endpoint), { method: 'POST', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ id: deviceID, name: 'Workbench browser', kind: 'web', publicKey }) });
					if (!enrolled.ok) throw new Error(`Device enrollment failed with HTTP ${enrolled.status}`);
					sessionStorage.setItem('workbench-sync-token', token);
					sessionStorage.setItem('workbench-sync-endpoint', endpoint);
					await moveLocalScope({ accountID: 'local-browser', workspaceID: WORKBENCH_WORKSPACE_ID }, { accountID: claims.sub, workspaceID: WORKBENCH_WORKSPACE_ID });
					scope.accountID = claims.sub;
					scope.deviceID = deviceID;
					updateCloudControls(true);
					cloudStatus.textContent = 'Connected. Catch-up sync is ready.';
					scheduleForegroundSync('initial connect');
				} catch (error) { cloudStatus.textContent = `Could not connect: ${String(error)}`; }
			}
			async function beginAccessLogin() {
				const endpoint = cloudEndpoint.value.trim().replace(/\/$/, '');
				if (!endpoint.startsWith('https://')) { cloudStatus.textContent = 'Enter the HTTPS sync API URL.'; return; }
				cloudStatus.textContent = 'Loading Cloudflare Access sign-in…';
				try {
					const response = await fetch(new URL('/sync/auth/config', endpoint));
					const config = await response.json();
					if (!response.ok) throw new Error(config.error === 'access_oidc_not_configured' ? 'Cloudflare Access OIDC is not configured on the staging Worker yet.' : `Access sign-in setup failed with HTTP ${response.status}`);
					const random = () => encodeBase64Url(crypto.getRandomValues(new Uint8Array(32)));
					const verifier = random();
					const state = random();
					const nonce = random();
					const challenge = encodeBase64Url(new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(verifier))));
					const redirectURI = location.origin + location.pathname;
					sessionStorage.setItem('workbench-access-pending', JSON.stringify({ state, nonce, verifier, redirectURI, endpoint }));
					sessionStorage.setItem('workbench-sync-endpoint', endpoint);
					const authorize = new URL(config.authorizationURL);
					authorize.search = new URLSearchParams({ response_type: 'code', client_id: config.clientID, redirect_uri: redirectURI, scope: 'openid email profile', state, nonce, code_challenge: challenge, code_challenge_method: 'S256' }).toString();
					location.assign(authorize);
				} catch (error) { cloudStatus.textContent = `Could not start sign-in: ${String(error)}`; }
			}
			async function finishAccessLogin() {
				const params = new URLSearchParams(location.search);
				const code = params.get('code');
				if (!code && !params.has('error')) return;
				const pending = JSON.parse(sessionStorage.getItem('workbench-access-pending') ?? 'null');
				history.replaceState(null, '', location.pathname + location.hash);
				if (params.has('error')) { sessionStorage.removeItem('workbench-access-pending'); cloudStatus.textContent = `Cloudflare Access sign-in failed: ${params.get('error_description') ?? params.get('error')}`; return; }
				if (!pending || params.get('state') !== pending.state) { sessionStorage.removeItem('workbench-access-pending'); cloudStatus.textContent = 'Access sign-in state did not match. Please try again.'; return; }
				cloudStatus.textContent = 'Completing Cloudflare Access sign-in…';
				try {
					const response = await fetch(new URL('/sync/auth/token', pending.endpoint), { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ code, codeVerifier: pending.verifier, nonce: pending.nonce, redirectURI: pending.redirectURI }) });
					const result = await response.json();
					if (!response.ok) throw new Error(result.error === 'access_oidc_not_configured' ? 'Cloudflare Access OIDC is not configured on the staging Worker yet.' : `Token exchange failed with HTTP ${response.status}`);
					sessionStorage.removeItem('workbench-access-pending');
					await connectAccessToken(result.idToken, pending.endpoint);
				} catch (error) { sessionStorage.removeItem('workbench-access-pending'); cloudStatus.textContent = `Could not finish sign-in: ${String(error)}`; }
			}
			document.querySelector('#cloud-connect').addEventListener('click', beginAccessLogin);
			await finishAccessLogin();
			async function runSync(trigger, userInitiated = false) {
				if (syncInFlight) return;
				const token = sessionStorage.getItem('workbench-sync-token');
				if (!token) return;
				let claims;
				try {
					claims = JSON.parse(atob(token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));
					if (!claims.sub || (claims.exp && claims.exp * 1000 <= Date.now())) throw new Error('sign-in expired');
				} catch {
					requireSignIn();
					cloudStatus.textContent = 'Sign in again to resume sync. Local changes are waiting safely.';
					return;
				}
				syncInFlight = true;
				cloudSyncButton.disabled = true;
				if (!userInitiated) cloudStatus.textContent = `Syncing after ${trigger}…`;
				try {
				const endpoint = sessionStorage.getItem('workbench-sync-endpoint') ?? defaultSyncEndpoint;
					scope.accountID = claims.sub;
					const deviceID = scope.deviceID ?? await getInstallationDeviceID();
					const result = await syncWorkspace(endpoint, token, scope, deviceID);
					lastSyncAt = Date.now();
					cloudStatus.textContent = `Sync complete · pushed ${result.pushed}, pulled ${result.pulled}`;
					if (recordKinds[activeView]) await renderLocalRecords(activeView);
				} catch (error) {
					const message = String(error);
					if (/HTTP 401|HTTP 403/.test(message)) {
						requireSignIn();
						cloudStatus.textContent = 'Sign in again to resume sync. Local changes are waiting safely.';
					} else cloudStatus.textContent = `Sync needs retry: ${message}`;
				} finally {
					syncInFlight = false;
					cloudSyncButton.disabled = false;
				}
			}
			function scheduleForegroundSync(trigger) {
				if (!sessionStorage.getItem('workbench-sync-token') || syncInFlight) return;
				clearTimeout(scheduledSync);
				scheduledSync = setTimeout(() => {
					if (Date.now() - lastSyncAt >= 1_000) void runSync(trigger);
				}, 350);
			}
			cloudSyncButton.addEventListener('click', () => void runSync('manual request', true));
			window.addEventListener('online', () => scheduleForegroundSync('network reconnect'));
			document.addEventListener('visibilitychange', () => {
				if (document.visibilityState === 'visible') scheduleForegroundSync('returning to this tab');
			});
			setInterval(() => scheduleForegroundSync('periodic catch-up'), 300_000);
			if (storedToken) scheduleForegroundSync('tab start');
			cloudDisconnectButton.addEventListener('click', () => {
				sessionStorage.removeItem('workbench-sync-token');
				sessionStorage.removeItem('workbench-sync-endpoint');
				sessionStorage.removeItem('workbench-access-pending');
				updateCloudControls(false);
				scope.accountID = 'local-browser';
				delete scope.deviceID;
			});
			const menuButton = document.querySelector('.mobile-menu');
			menuButton.addEventListener('click', () => {
				const expanded = menuButton.getAttribute('aria-expanded') === 'true';
				menuButton.setAttribute('aria-expanded', String(!expanded));
				document.querySelector('.sidebar').classList.toggle('mobile-open', !expanded);
			});
			const initial = location.hash.slice(1);
			if (labels[initial]) showView(initial);
			const now = new Date();
			document.querySelector('#today-label').textContent = new Intl.DateTimeFormat(undefined, { weekday: 'long', month: 'long', day: 'numeric' }).format(now).toUpperCase();
			const hour = now.getHours();
			document.querySelector('#greeting').textContent = hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';
		</script>
		<style>
